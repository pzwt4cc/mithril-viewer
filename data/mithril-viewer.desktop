[Desktop Entry]
Type=Application
Name=Mithril Viewer
GenericName=Image Viewer
GenericName[ru]=Просмотрщик изображений
Comment=Fast, minimal image viewer
Comment[ru]=Быстрый минималистичный просмотрщик изображений
Exec=mithril-viewer %f
Icon=mithril-viewer
Terminal=false
Categories=Graphics;Viewer;2DGraphics;RasterGraphics;VectorGraphics;
MimeType=image/png;image/jpeg;image/gif;image/webp;image/bmp;image/svg+xml;image/svg+xml-compressed;image/avif;image/x-icon;image/vnd.microsoft.icon;image/tiff;image/x-qoi;
Keywords=image;picture;photo;viewer;gif;png;jpeg;webp;bmp;svg;avif;ico;tiff;qoi;
Keywords[ru]=изображение;картинка;фото;просмотр;
StartupWMClass=mithril-viewer
