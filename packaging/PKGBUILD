# Maintainer: pzwt4cc
pkgname=mithril-viewer-git
_pkgname=mithril-viewer
pkgver=0.1.0
pkgrel=1
pkgdesc='Fast, minimal GPU-accelerated image viewer'
arch=('x86_64' 'aarch64')
url='https://github.com/pzwt4cc/mithril-viewer'
license=('MIT')
depends=('gcc-libs' 'glibc' 'fontconfig' 'libglvnd' 'libx11' 'libxkbcommon' 'wayland')
makedepends=('cargo' 'git')
optdepends=('cups: printing support'
            'xdg-utils: open the containing folder')
provides=("$_pkgname")
conflicts=("$_pkgname")
source=("$_pkgname::git+$url.git")
sha256sums=('SKIP')

pkgver() {
  cd "$_pkgname"
  local ver
  ver=$(grep -m1 '^version' Cargo.toml | cut -d'"' -f2)
  printf '%s.r%s.g%s' "$ver" "$(git rev-list --count HEAD)" "$(git rev-parse --short=7 HEAD)"
}

prepare() {
  cd "$_pkgname"
  export RUSTUP_TOOLCHAIN=stable
  cargo fetch --locked --target "$(rustc -vV | sed -n 's/host: //p')"
}

build() {
  cd "$_pkgname"
  export RUSTUP_TOOLCHAIN=stable
  export CARGO_TARGET_DIR=target
  cargo build --frozen --release
}

package() {
  cd "$_pkgname"

  install -Dm755 target/release/mithril-viewer "$pkgdir/usr/bin/mithril-viewer"

  install -Dm644 data/mithril-viewer.desktop \
    "$pkgdir/usr/share/applications/mithril-viewer.desktop"
  install -Dm644 data/mithril-viewer.metainfo.xml \
    "$pkgdir/usr/share/metainfo/mithril-viewer.metainfo.xml"

  install -Dm644 data/icons/hicolor/scalable/apps/mithril-viewer.svg \
    "$pkgdir/usr/share/icons/hicolor/scalable/apps/mithril-viewer.svg"
  for size in 16 24 32 48 64 128 256 512; do
    install -Dm644 "data/icons/hicolor/${size}x${size}/apps/mithril-viewer.png" \
      "$pkgdir/usr/share/icons/hicolor/${size}x${size}/apps/mithril-viewer.png"
  done

  install -Dm644 LICENSE "$pkgdir/usr/share/licenses/$pkgname/LICENSE"
  # лицензия встроенного шрифта Inter (SIL OFL)
  install -Dm644 assets/OFL.txt "$pkgdir/usr/share/licenses/$pkgname/OFL.txt"
}
